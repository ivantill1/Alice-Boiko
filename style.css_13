* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f1f5f9;
    color: #334155;
    line-height: 1.5;
}

.page-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 20px;
}

.box-card {
    background: #ffffff;
    padding: 30px;
    border: 2px solid #cbd5e1;
    border-radius: 12px;
    margin-bottom: 20px;
}

.box-card h2 {
    margin-bottom: 15px;
    font-size: 24px;
    color: #1e293b;
}

.box-card p {
    font-size: 16px;
    color: #64748b;
}
