<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Современная верстка на Flexbox
</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header class="header">
        <div class="logo">Логотип</div>
        <nav class="nav-menu">
            <a href="#">Главная</a>
            <a href="#">О нас</a>
            <a href="#">Контакты</a>
        </nav>
    </header>

    <main class="content-container">
        <div class="flex-card">Карточка 1</div>
        <div class="flex-card">Карточка 2</div>
        <div class="flex-card">Карточка 3</div>
    </main>
</body>
</html>
