* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.hero-banner {
    height: 100vh;
    background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(46, 16, 101, 0.6)), 
                      url('https://img.magnific.com/free-photo/beautiful-shot-white-british-shorthair-kitten_181624-57681.jpg?semt=ais_hybrid&w=740&q=80');
    background-size: cover;
    background-position: center;
    display: flex;
    justify-content: center;
    align-items: center;
}

.glass-card {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 40px;
    border-radius: 16px;
    text-align: center;
    color: #ffffff;
    max-width: 450px;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
}

.glass-card h1 {
    margin-bottom: 15px;
    font-size: 28px;
}

.glass-card p {
    margin-bottom: 25px;
    font-size: 16px;
    color: #f0f0f0;
}

.cta-button {
    background: linear-gradient(135deg, #6e8efb, #a777e3);
    color: white;
    border: none;
    padding: 12px 28px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(110, 142, 251, 0.4);
    transition: all 0.3s ease;
}

.cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(167, 119, 227, 0.6);
    background: linear-gradient(135deg, #5c7de0, #9562d1);
}
